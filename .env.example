# Leave unset to use the embedded PGlite database in ~/.farmora/pglite
DATABASE_URL=postgres://farmora:farmora@localhost:5432/farmora
NEXT_PUBLIC_BRAND_NAME=TrueHarvest
# Set once an SMS gateway is wired in lib/auth.ts; until then the OTP is shown on screen
# SMS_PROVIDER=msg91
# INSECURE_COOKIES=1   # only when serving production over plain HTTP
# DISABLE_JOBS=1       # run background jobs from an external scheduler instead
